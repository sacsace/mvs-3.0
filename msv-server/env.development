# MVS Backend Development Environment
NODE_ENV=development
DISABLE_SYNC=true
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# 다른 기기에서 http://<이 PC LAN IP>:3000 으로 접속 시:
# CORS_ORIGIN=http://localhost:3000,http://192.168.0.10:3000
# 프로덕션 모드로 띄운 뒤 LAN IP로만 접속할 때(사설망 Origin 일괄 허용):
# CORS_ALLOW_LAN=true

# 데이터베이스 설정 (로컬 PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mvs
DB_USER=mvs_user
DB_PASSWORD=Korean@2026

# HeresNow ↔ MVS 근태 연동 (www.heresnow.in)
# HERESNOW_API_BASE_URL=https://www.heresnow.in
# MVS_INTEGRATION_API_KEY=
# INTEGRATION_DISPATCH_SECRET=
# MVS_WEBHOOK_BEARER=

# Redis 설정 (로컬 Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# 보안 설정
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-development
SESSION_SECRET=your-session-secret-key-for-development

# 파일 업로드 설정
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10mb

# 로깅 설정
LOG_LEVEL=debug

# 개발용 설정
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# 대시보드 설정
DEFAULT_TENANT_ID=1
LOW_STOCK_THRESHOLD=10
HIGH_STOCK_THRESHOLD=100