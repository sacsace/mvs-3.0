{
  "name": "msv-server",
  "version": "3.0.0",
  "description": "MVS Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.cpSync('src','dist',{recursive:true}); console.log('Files copied successfully');\"",
    "start": "node src/index.ts",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start:railway": "node scripts/railway-bootstrap.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm run test && npm run test:coverage",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:railway": "node scripts/run-migrations.cjs",
    "db:restore:railway": "node scripts/restore-railway-db.cjs",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:seed:data": "ts-node scripts/seed-data.ts",
    "db:export:menus": "node scripts/export-menus.cjs",
    "db:import:menus": "node scripts/import-menus.cjs data/menus-dev-export.json --tenant=1 --sync-permissions",
    "db:fix:columns": "ts-node scripts/fix-columns.ts",
    "db:fix:menu-order": "ts-node scripts/fix-menu-order.ts",
    "db:check:menus": "ts-node scripts/check-menus.ts",
    "db:add:submenus": "ts-node scripts/add-submenus.ts",
    "db:check:company-columns": "ts-node scripts/check-and-add-company-columns.ts",
    "db:sync:company-columns": "ts-node scripts/sync-company-columns.ts",
    "db:add:bank-address": "ts-node scripts/add-bank-address-column.ts",
    "db:check:gst-table": "ts-node scripts/check-gst-table-exists.ts",
    "db:create:gst-table": "ts-node scripts/create-gst-table.ts",
    "db:check:attendance": "ts-node scripts/check-attendance-tables.ts",
    "db:check:company": "ts-node scripts/check-company-data.ts",
    "db:create:partners-table": "ts-node scripts/create-partners-table.ts",
    "db:create:gst-indexes": "ts-node scripts/create-gst-table-indexes.ts",
    "db:fix:column-lengths": "ts-node scripts/fix-company-column-lengths.ts",
    "db:check:company-gst": "ts-node scripts/check-company-gst-join.ts",
    "db:add:user-hr-columns": "ts-node scripts/check-and-add-user-hr-columns.ts",
    "db:add:hotel-menus": "ts-node scripts/add-hotel-menus.ts",
    "db:fix:vacation-enum": "node scripts/add-vacation-enum-values.js",
    "db:add:employment-daily-enum": "node scripts/add-user-employment-daily-enum.js",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "db:setup": "node scripts/migrate.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "health": "node -e \"console.log('Backend is healthy')\""
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/react-grid-layout": "^1.3.6",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "i18next": "^23.7.6",
    "i18next-fs-backend": "^2.2.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.18.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "react-grid-layout": "^2.2.2",
    "redis": "^4.6.10",
    "sequelize": "^6.35.0",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^3.0.13",
    "@types/pdfkit": "^0.13.9",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
